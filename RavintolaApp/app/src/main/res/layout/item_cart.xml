<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Food image / Custom pizza icon -->
        <ImageView
            android:id="@+id/iv_cart_food_pic"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/food_pizza"
            android:scaleType="centerCrop"
            android:background="@drawable/card_background"
            android:backgroundTint="@color/background"
            android:padding="2dp" />

        <!-- Info details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tv_cart_item_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pepperoni Pizza"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tv_cart_item_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 x $9.50"
                android:textColor="@color/text_hint"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Quantity panel -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@drawable/input_background"
            android:backgroundTint="@color/background"
            android:padding="2dp"
            android:layout_marginHorizontal="8dp">

            <ImageButton
                android:id="@+id/btn_cart_minus"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@android:drawable/ic_media_previous"
                android:tint="@color/white"
                android:background="@drawable/transparent"
                android:padding="6dp" />

            <TextView
                android:id="@+id/tv_cart_qty"
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center" />

            <ImageButton
                android:id="@+id/btn_cart_plus"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@android:drawable/ic_input_add"
                android:tint="@color/white"
                android:background="@drawable/transparent"
                android:padding="6dp" />

        </LinearLayout>

        <!-- Action / Subtotal column -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tv_cart_item_subtotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$9.50"
                android:textColor="@color/accent"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btn_cart_delete"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_menu_delete"
                android:tint="@color/error"
                android:background="@drawable/transparent"
                android:padding="6dp"
                android:layout_marginTop="4dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
